# Copy this file to `.env` (same directory as the notebooks) and fill in the values.
# The real `.env` is git-ignored; this template is committed so collaborators and graders
# know which variables to set.

# Kaggle API credentials, used by Section 4 of data-setup.ipynb to download the
# RSNA Pneumonia Detection Challenge dataset. Generate a token at
# https://www.kaggle.com/settings ("Create New Token") and accept the competition
# rules at https://www.kaggle.com/competitions/rsna-pneumonia-detection-challenge/rules
# before running the download.
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key
